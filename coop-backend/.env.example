# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=lascstudent
DB_PASSWORD=lascstudent!
DB_NAME=lascstudent

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# URL ของ frontend ฝั่ง Coop (รวม base path /coop) ใช้สร้างลิงก์แบบประเมินในอีเมล
COOP_PUBLIC_URL=http://localhost:5173/coop

# SMTP สำหรับส่งอีเมลแบบประเมินให้สถานประกอบการ
# ถ้าเว้นว่าง ระบบจะไม่ส่งอีเมลจริงแต่จะ log ลิงก์ไว้ใน console แทน
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ฝ่ายฝึกงาน มรภ.ศรีสะเกษ" <noreply@sskru.ac.th>

# SSO จากระบบฐานข้อมูลนักศึกษา — ต้องตรงกับค่าใน profile-backend
SSO_SHARED_SECRET=
