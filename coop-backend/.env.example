# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=lascstudent
DB_PASSWORD=lascstudent!
DB_NAME=lascstudent

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# URL ของ frontend — ใช้สร้างลิงก์ในอีเมลและ CORS
# Production: ตั้งเป็นโดเมนจริงที่มี HTTPS เช่น FRONTEND_URL=https://coop.sskru.ac.th
# (ใส่ได้ทั้งแบบมี/ไม่มี /coop — ระบบ normalize ให้อัตโนมัติ)
FRONTEND_URL=http://localhost:5173
COOP_PUBLIC_URL=http://localhost:5173/coop

# CORS — โดเมนเพิ่มเติมที่อนุญาต (comma-separated) เช่น https://domain-a.com,https://domain-b.com
# ไม่ต้องใส่ localhost หรือ FRONTEND_URL ซ้ำ — รวมให้อัตโนมัติแล้ว
CORS_ORIGIN=

# SMTP สำหรับส่งอีเมลแบบประเมินให้สถานประกอบการ
# ถ้าเว้นว่าง ระบบจะไม่ส่งอีเมลจริงแต่จะ log ลิงก์ไว้ใน console แทน
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ฝ่ายฝึกงาน มรภ.ศรีสะเกษ" <noreply@sskru.ac.th>

# Gmail API OAuth2 — ส่งอีเมลทั้งหมดผ่าน Gmail REST API (HTTPS 443) ไม่พึ่งพอร์ต SMTP
# สร้าง Client ID/Secret จาก Google Cloud Console และสร้าง Refresh Token จาก OAuth2 Playground
# (scope: https://www.googleapis.com/auth/gmail.send)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_FROM_NAME=ระบบงานฝึกงาน LASC

# อีเมลแอดมินปลายทาง — รับแจ้งเตือนเมื่อสถานประกอบการส่งแบบประเมิน (เพิ่มเติมจากอีเมล admin ใน DB)
ADMIN_EMAIL=

# SSO จากระบบฐานข้อมูลนักศึกษา — ต้องตรงกับค่าใน profile-backend
SSO_SHARED_SECRET=
