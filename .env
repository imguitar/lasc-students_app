# ==========================================================
#  LASC Students App — Local Docker environment
#  คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามต้องการ
#     cp .env.example .env
# ==========================================================

NODE_ENV=development

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=lascstudent
MYSQL_USER=lascstudent
MYSQL_PASSWORD=lascstudent!
# สำหรับ DATABASE_URL ของ Prisma (! ต้องเขียนเป็น %21)
MYSQL_PASSWORD_URLENCODED=lascstudent%21
# พอร์ตฝั่ง host (ใช้ 3307 เพราะเครื่องนี้มี MySQL local ครอง 3306 อยู่แล้ว)
MYSQL_PORT=3307

# ===== phpMyAdmin =====
PHPMYADMIN_PORT=8080

# ===== App 1: ระบบฐานข้อมูลนักศึกษา (profile) =====
# หมายเหตุ: พอร์ต 5000 บน macOS ถูก AirPlay Receiver ใช้อยู่ จึง map เป็น 5001
PROFILE_BACKEND_PORT=5001
PROFILE_FRONTEND_PORT=3000

# ===== App 2: ระบบศูนย์ฝึกนักศึกษา (coop) =====
COOP_BACKEND_PORT=5002
COOP_FRONTEND_PORT=5173

# ===== Local URLs =====
PROFILE_PUBLIC_URL=http://localhost:3000
COOP_PUBLIC_URL=http://localhost:5173/coop
PROFILE_API_URL=http://localhost:5001/api
COOP_API_URL=http://localhost:5002/api
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ===== Backend JWT =====
# แยก secret คนละตัวต่อแอป เพื่อไม่ให้ token ของอีกแอปผ่าน auth ข้ามระบบได้
PROFILE_JWT_SECRET=change_this_profile_secret_to_a_long_random_string
COOP_JWT_SECRET=change_this_coop_secret_to_a_different_long_random_string
JWT_EXPIRES_IN=7d

# ===== SSO: ล็อกอินที่ระบบ profile แล้วเข้าระบบ coop ต่อได้โดยไม่ต้องล็อกอินใหม่ =====
# ต้องเป็นค่าเดียวกันทั้งสอง backend และต้องต่างจาก JWT secret ข้างบน
SSO_SHARED_SECRET=change_this_sso_secret_to_another_long_random_string

# ===== SMTP สำหรับส่งอีเมลแบบประเมินให้สถานประกอบการ (ระบบ coop) และแจ้งเตือนกิจกรรม (ระบบ profile) =====
# เว้นว่างไว้ได้ ระบบจะไม่ส่งอีเมลจริงแต่ log ลิงก์ไว้ใน console แทน
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Gmail API OAuth2 — ส่งอีเมลทั้งหมดผ่าน Gmail REST API (HTTPS 443) ไม่พึ่งพอร์ต SMTP
# สร้าง Client ID/Secret จาก Google Cloud Console และสร้าง Refresh Token จาก OAuth2 Playground
# (scope: https://www.googleapis.com/auth/gmail.send)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GMAIL_FROM_NAME=ระบบงานฝึกงาน LASC

# อีเมลแอดมินปลายทาง — รับแจ้งเตือนเมื่อสถานประกอบการส่งแบบประเมิน (เพิ่มเติมจากอีเมล admin ใน DB)
ADMIN_EMAIL=

# ตัวเลือกเสริม: บริการ Transactional Email (Resend / SendGrid)
# EMAIL_PROVIDER สามารถระบุ: gmail_api, smtp, resend, sendgrid (เว้นว่างไว้เพื่อตรวจจับอัตโนมัติ)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

