# API Base URL for Frontend Backend Integration
# Production:
VITE_API_BASE_URL=https://students.sci-sskru.com/coop/api

# Profile API used to request an SSO ticket when Profile redirects back without one.
# Production defaults to https://<current-origin>/api when this value is omitted.
VITE_PROFILE_API_URL=https://students.sci-sskru.com/api

# For Local Development:
# VITE_API_BASE_URL=http://localhost:5000/api

# Profile System SSO Login URL
# Production:
VITE_PROFILE_LOGIN_URL=https://students.sci-sskru.com/login

# For Local Development:
# VITE_PROFILE_LOGIN_URL=http://localhost:3000/login
